{
  "crons": [
    {
      "path": "/api/notify-bills-due",
      "schedule": "0 11 * * *"
    }
  ],
  "routes": [
    { "src": "/api/finvision-chat", "dest": "/api/finvision-chat.ts" },
    { "src": "/api/categorize-transactions", "dest": "/api/categorize-transactions.ts" },
    { "src": "/api/process-import", "dest": "/api/process-import.ts" },
    { "src": "/api/handle-wealth-analysis", "dest": "/api/handle-wealth-analysis.ts" },
    { "src": "/api/handle-bank-reconcile", "dest": "/api/handle-bank-reconcile.ts" },
    { "src": "/api/handle-card-reconcile", "dest": "/api/handle-card-reconcile.ts" },
    { "src": "/api/asaas-webhook", "dest": "/api/index.ts" },
    { "src": "/api/whatsapp-webhook", "dest": "/api/index.ts" },
    { "src": "/api/notify-bills-due", "dest": "/api/index.ts" },
    { "src": "/api/parse-card-statement", "dest": "/api/parse-card-statement.ts" },
    { "src": "/api/parse-statement", "dest": "/api/parse-statement.ts" },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
