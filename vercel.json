{
  "routes": [
    {
      "src": "/sw\\.js",
      "dest": "/sw.js",
      "headers": {
        "Content-Type": "application/javascript; charset=UTF-8",
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/manifest\\.json",
      "dest": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json; charset=UTF-8",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}